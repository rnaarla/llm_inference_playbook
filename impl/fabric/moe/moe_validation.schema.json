{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "moe_validation_report",
  "type": "object",
  "required": ["profile", "model", "topology", "parallelism", "results", "gate"],
  "properties": {
    "profile": {"type": "string"},
    "model": {"type": "string"},
    "topology": {"type": "string"},
    "parallelism": {
      "type": "object",
      "required": ["tp", "pp", "ep"],
      "properties": {
        "tp": {"type": "integer", "minimum": 1},
        "pp": {"type": "integer", "minimum": 1},
        "ep": {"type": "integer", "minimum": 1}
      }
    },
    "results": {
      "type": "object",
      "required": ["ttft_p95_ms", "tpot_p95_ms", "expert_imbalance_ratio"],
      "properties": {
        "ttft_p95_ms": {"type": "number", "minimum": 0},
        "tpot_p95_ms": {"type": "number", "minimum": 0},
        "expert_imbalance_ratio": {"type": "number", "minimum": 0}
      }
    },
    "gate": {
      "type": "object",
      "required": ["passed", "notes"],
      "properties": {
        "passed": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}
